# /etc/gsactiond/gsactiond.env - settings for gsactiond.service
# Keep this file root-only (chmod 600): it holds the shared tokens.

# Shared token the phones send as token=...; gsprov must be given the same
# value with -token. Generate one with: openssl rand -hex 16
GSACTION_TOKEN=

# Bearer token required on /api requests (leave empty for no API auth).
GSACTION_API_TOKEN=

# Delete events and finished calls older than this; 0 keeps them forever.
GSACTION_RETENTION=90d

# debug logs every received event.
GSACTION_LOG_LEVEL=info

# Only used when gsactiond.socket is NOT enabled (the socket unit sets the
# port otherwise).
GSACTION_ADDR=:8086
